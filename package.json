{
  "name": "dopa-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint",
    "test": "vitest run",
    "test:release": "node --test scripts/test-*.mjs",
    "test:watch": "vitest",
    "test:ci": "vitest run",
    "check:cloudflare-only": "node scripts/check-cloudflare-only.mjs",
    "check:admin-runtime": "node scripts/check-admin-runtime-boundaries.mjs",
    "cf:build": "ADMIN_ENVIRONMENT=staging NEXT_PUBLIC_API_URL=https://dopa-backend-staging.ceoofspot.workers.dev NEXT_PUBLIC_CHAT_WS_URL=wss://dopa-backend-staging.ceoofspot.workers.dev/v2/chat opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:deploy:staging:plan": "node scripts/deploy-cloudflare-staging.mjs plan",
    "cf:deploy:staging": "node scripts/deploy-cloudflare-staging.mjs execute",
    "cf:build:production": "ADMIN_ENVIRONMENT=production NEXT_PUBLIC_API_URL=https://api.dopa.ing NEXT_PUBLIC_CHAT_WS_URL=wss://api.dopa.ing/v2/chat opennextjs-cloudflare build",
    "cf:deploy:production": "npm run cf:build:production && wrangler deploy --config wrangler.production.jsonc",
    "verify": "npm run test && npm run test:release && npm run check:admin-runtime && npm run lint && npm run cf:build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@sentry/nextjs": "^10.65.0",
    "@tanstack/react-query": "^5.101.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.22.0",
    "next": "^16.2.11",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "recharts": "^2.15.4",
    "shadcn": "^4.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "wrangler": "^4.120.0"
  }
}
