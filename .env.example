# Release-candidate browser contract: Cloudflare staging only.
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="https://dopa-backend-staging.ceoofspot.workers.dev"
NEXT_PUBLIC_CHAT_WS_URL="wss://dopa-backend-staging.ceoofspot.workers.dev/v2/chat"

# Optional observability. Do not commit real values.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SLACK_ERROR_WEBHOOK_URL=

# Legacy Prisma/BFF surfaces only. These are not part of the Cloudflare release
# candidate and must not be configured for a new deployment.
DATABASE_URL="postgresql://user:password@localhost:5432/spot_db?schema=public"
BACKEND_INTERNAL_URL="http://localhost:3000"
BACKEND_INTERNAL_API_KEY="change_me_internal_key"
LEGACY_BFF_METRICS_TOKEN=

# Optional local place search used by party registration.
KAKAO_REST_API_KEY=
