/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://accounts.google.com https://appleid.cdn-apple.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://api.dopa.ing https://dopa-backend.ceoofspot.workers.dev https://dopa-backend-staging.ceoofspot.workers.dev wss://api.dopa.ing wss://dopa-backend-staging.ceoofspot.workers.dev https://*.ingest.sentry.io https://*.sentry.io https://accounts.google.com https://appleid.apple.com; frame-src https://accounts.google.com https://appleid.apple.com; worker-src 'self' blob:; media-src 'self' blob:; upgrade-insecure-requests
